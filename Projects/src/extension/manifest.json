{
  "manifest_version": 3,
  "name": "Tubify",
  "version": "1.0.0",
  "description": "유튜브 검색 결과 상단에 AI 요약 대시보드를 오버레이로 표시합니다.",

  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "sidePanel"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "side_panel": {
    "default_path": "side_panel.html"
  },

  "externally_connectable": {
    "matches": [
      "https://port-0-swproject-team2-m-mpdo8rl036709628.sel3.cloudtype.app/*"
    ]
  },

  "host_permissions": [
    "https://www.youtube.com/*",
    "https://port-0-swproject-team2-m-mpdo8rl036709628.sel3.cloudtype.app/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["config.js", "content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "Tubify"
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
